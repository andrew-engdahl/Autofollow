#!/bin/bash
# Autofollow.app — macOS Dock launcher.
# Uses python -S (no-site / isolated) to skip pyvenv.cfg so the app can
# launch from the Dock without needing Full Disk Access permission.

MACOS_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
PROJECT_DIR="$( cd "$MACOS_DIR/../../.." && pwd )"
VENV="$PROJECT_DIR/.venv"
MAIN="$PROJECT_DIR/main.py"

fail() {
    osascript -e "display alert \"Autofollow\" message \"$1\" as critical"
    exit 1
}

[ -f "$MAIN" ] || fail "Could not find main.py at:\n$MAIN"
[ -d "$VENV" ] || fail "Virtual environment not found at:\n$VENV\n\nRun setup.sh first."

# Resolve the interpreter the venv was built with.  pyvenv.cfg's 'home' is a
# stable path (e.g. /opt/homebrew/opt/python@3.13/bin) that survives Homebrew
# point-release upgrades, unlike a hard-coded Cellar path.
PY_HOME="$(sed -n 's/^home *= *//p' "$VENV/pyvenv.cfg" | head -n1)"
PY_VER="$(sed -n 's/^version *= *\([0-9]*\.[0-9]*\).*/\1/p' "$VENV/pyvenv.cfg" | head -n1)"
PYTHON=""
for cand in "$PY_HOME/python$PY_VER" "$PY_HOME/python3" "$(readlink -f "$VENV/bin/python" 2>/dev/null)"; do
    if [ -n "$cand" ] && [ -x "$cand" ]; then
        PYTHON="$cand"
        break
    fi
done
[ -n "$PYTHON" ] || fail "Python $PY_VER not found for the virtual environment.\n\nRe-run setup.sh."

SITE="$(ls -d "$VENV"/lib/python3.*/site-packages 2>/dev/null | head -n1)"
[ -n "$SITE" ] || fail "No site-packages found in:\n$VENV/lib\n\nRe-run setup.sh."

cd "$PROJECT_DIR"

# -S skips site.py and pyvenv.cfg — we inject the venv site-packages and
# project root ourselves via PYTHONPATH before importing anything.
export PYTHONPATH="$SITE:$PROJECT_DIR"
exec "$PYTHON" -S -c "
import sys, sysconfig

# Restore stdlib paths that -S strips out
for p in (sysconfig.get_path('platstdlib'), sysconfig.get_path('stdlib')):
    if p and p not in sys.path:
        sys.path.append(p)

# Fix argv so argparse sees no extra arguments
sys.argv = sys.argv[1:]

import runpy
runpy.run_path(sys.argv[0], run_name='__main__')
" "$MAIN"
